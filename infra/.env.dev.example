# Дев-окружение. Скопируй в .env при необходимости переопределить дефолты:
#   cp .env.dev.example .env
# Каждая переменная: Назначение / Обязательность / Default.

# PostgreSQL (локальный контейнер).
# Назначение: учётка и имя БД. Обязательность: нет (есть дефолты). Default: roof/roof/roof_dupes
POSTGRES_USER=roof
POSTGRES_PASSWORD=roof          # СЕКРЕТ — на stage/prod инжектится при деплое
POSTGRES_DB=roof_dupes

# Бэкенд.
# Назначение: уровень логов. Обязательность: нет. Default: info
LOG_LEVEL=info
# Назначение: параллелизм воркера обработки фото. Обязательность: нет. Default: 4
INGEST_CONCURRENCY=4
# Назначение: макс. Hamming-расстояние для «почти-дубля» (pHash/dHash). Обязательность: нет. Default: 10
PHASH_THRESHOLD=10
# Назначение: минимальный risk_score, чтобы совпадение попало в очередь. Обязательность: нет. Default: 31
MATCH_PERSIST_THRESHOLD=31
